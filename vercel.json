{
  "version": 2,
  "redirects": [
    { "source": "/", "destination": "/web/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/script.js", "destination": "/web/script.js" },
    { "source": "/assets/:path*", "destination": "/web/assets/:path*" }
  ]
}
